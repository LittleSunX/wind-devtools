{
  "name": "wind-devtools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build --manifest && tsx scripts/prerender.ts --production",
    "build:production": "tsc -b && vite build --manifest && tsx scripts/prerender.ts --production",
    "build:preview": "tsc -b && vite build --manifest && tsx scripts/prerender.ts --preview",
    "test:diff": "node scripts/diff-check.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.js index.html",
    "format:check": "prettier --check src scripts tests *.json *.ts *.js index.html",
    "test:build": "node scripts/build-check.mjs",
    "test:code-image": "node scripts/code-image-check.mjs",
    "test:canvas-workbench": "node scripts/canvas-workbench-check.mjs",
    "test:compat": "node scripts/compat-check.mjs",
    "test:sidebar": "node scripts/sidebar-check.mjs",
    "test:i18n": "node scripts/i18n-check.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "cron-parser": "^5.0.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.2",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.14",
    "sql-formatter": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.7",
    "tsx": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
