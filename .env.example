# Optional override for the production origin in site.config.json.
# npm run build and build:production enable SEO; build:preview disables indexing.
# Vercel preview/development builds always disable indexing.
SITE_URL=

# Optional Umami >= 2.18.0. All three values are required.
# Only production builds on this exact hostname will load analytics.
# Never put secret API keys in VITE_* variables (they are public).
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_ALLOWED_HOST=
